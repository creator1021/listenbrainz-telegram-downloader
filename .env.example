# Used only by compose.production.yml. Replace with your published image.
DOCKER_IMAGE=your-dockerhub-username/listenbrainz-telegram-downloader
IMAGE_TAG=latest

# Get these two values at https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional. If blank, the one-time auth command prompts for it.
TELEGRAM_PHONE=

# Ordered fallback list: A, then B, then C. Prefer IDs for private channels.
# Run the included `channels` command after authenticating to discover IDs.
TELEGRAM_CHANNELS=-1001111111111,-1002222222222,@public_channel_c

LISTENBRAINZ_USERNAME=
# Recent listens are normally public, so this is optional.
LISTENBRAINZ_TOKEN=

POLL_INTERVAL_SECONDS=300
INITIAL_LOOKBACK_HOURS=6
LISTEN_FETCH_COUNT=100
LISTEN_FETCH_MAX_PAGES=10
SEARCH_RESULTS_PER_QUERY=50
MATCH_THRESHOLD=76
RETRY_INTERVAL_MINUTES=60
MAX_RETRY_HOURS=168
MAX_TRACKS_PER_CYCLE=10
MAX_FILE_SIZE_MB=150
ALLOWED_EXTENSIONS=mp3,m4a,flac,ogg,opus,wav,aac
WRITE_METADATA=true
METADATA_FALLBACK_ALBUM=
# Forward audio to Telegram Saved Messages to import it automatically.
WATCH_SAVED_MESSAGES=false
# On first enable, inspect only this many recent Saved Messages.
SAVED_MESSAGES_INITIAL_LIMIT=20
# Number of recent messages checked during each later polling cycle.
SAVED_MESSAGES_POLL_LIMIT=200
# 0 automatically uses max(300, POLL_INTERVAL_SECONDS * 3).
HEALTHCHECK_MAX_AGE_SECONDS=0
DRY_RUN=false
LOG_LEVEL=INFO

DATA_DIR=/data
DOWNLOAD_DIR=/downloads
TELEGRAM_SESSION=/data/telegram
